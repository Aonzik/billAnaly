# ============================================================
# billAnaly 跨平台换行符与文件属性配置
# 目的：保证 Windows / Linux / macOS 三端 clone 后行为一致
# ============================================================

# --- 默认策略：仓库内一律存 LF ---------------------------------
# 所有文本文件在仓库中以 LF 存储；检出到工作区时，
# text=auto 交由 Git 按平台决定（Windows 上默认仍转成 CRLF）。
* text=auto

# --- Shell 脚本必须保持 LF ------------------------------------
# CRLF 会让 Linux/macOS 上的 shebang 变成 "#!/bin/bash\r"，
# 直接报 "bad interpreter: No such file or directory"，脚本无法运行。
*.sh        text eol=lf
*.command   text eol=lf
*.bash      text eol=lf

# --- Windows 批处理必须保持 CRLF ------------------------------
# .bat/.cmd 用 LF 结尾在部分 Windows 环境下会出现
# 标签跳转错乱、行尾吞字符等诡异问题，强制 CRLF。
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# --- 源码与文档：统一 LF --------------------------------------
# 纯文本按 LF 归一化，避免跨系统协作时整文件 diff 噪音。
*.py        text eol=lf
*.js        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
.gitignore  text eol=lf

# --- 二进制文件：禁止任何换行符转换 ---------------------------
# 不加 -text 的话，Git 可能把二进制里的 0x0D0A 当换行改写，
# 造成图标/数据库/压缩包损坏且难以排查。
*.db        binary
*.sqlite    binary
*.sqlite3   binary
*.ico       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.svg       text eol=lf
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.7z        binary
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary

# --- 第三方压缩后的前端资源 -----------------------------------
# static/js/*.min.js 由 curl 下载，保持原样、不要做文本转换。
*.min.js    binary
*.min.css   binary

# --- Git 统计与语言识别 ---------------------------------------
# 让 git diff / GitHub 把 vendored 的静态资源折叠显示，
# 并避免 Linguist 把本仓库误判为纯 JavaScript 项目。
static/js/* linguist-vendored
static/favicon.ico linguist-detectable=false

# --- 归档与导出 -----------------------------------------------
# git archive 时自动展开占位符（提交哈希注入），便于打包发布。
server.py export-subst
